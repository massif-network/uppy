{
  "name": "@massif-network/smugmug",
  "description": "Import files from SmugMug into Uppy (Massif fork plugin).",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --build"
  },
  "keywords": [
    "file uploader",
    "uppy",
    "uppy-plugin",
    "smugmug"
  ],
  "homepage": "https://github.com/massif-network/uppy/tree/main/packages/@massif-network/smugmug",
  "bugs": {
    "url": "https://github.com/massif-network/massif/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massif-network/uppy.git",
    "directory": "packages/@massif-network/smugmug"
  },
  "files": [
    "src",
    "lib",
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@uppy/companion-client": "workspace:^",
    "@uppy/provider-views": "workspace:^",
    "@uppy/utils": "workspace:^",
    "preact": "^10.29.2"
  },
  "peerDependencies": {
    "@uppy/core": "workspace:^"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@uppy/core": "workspace:^",
    "typescript": "^5.8.3"
  }
}
